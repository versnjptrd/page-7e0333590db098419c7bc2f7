{grid-template-columns:1fr}\n    .client-grid{grid-template-columns:1fr}\n    .section{padding:48px 20px}\n    .crumb .dir{display:none}\n  }\n</style><nav class=\"crumb\">\n  <a href=\"#\">首页</a>\n  <span>›</span>\n  <span>七八云</span>\n  <span class=\"dir\">\n    <a href=\"#about\">了解</a>\n    <a href=\"#plans\">套餐</a>\n    <a href=\"#guide\">使用</a>\n    <a href=\"#faq\">问答</a>\n    <a href=\"#clients\">客户端</a>\n  </span>\n</nav>\n\n<main>\n\n<section class=\"hero\">\n  <div class=\"hero-left\">\n    <h1>七八云</h1>\n    <p class=\"lede\">让每一比特都走对路。我们关注的是链路调度的细节、节点池的均衡，以及你在不同时段拿到手的实际带宽——而不是漂亮的营销话术。</p>\n    <p class=\"qline\">不知道该选哪个？继续往下看，三个问题帮你定位。</p>\n  </div>\n  <div class=\"hero-right\">\n    <div class=\"panel-title\">快速信息面板</div>\n    <div class=\"panel-row\"><b>套餐层级</b><span>基础 / 旗舰 / 团队</span></div>\n    <div class=\"panel-row\"><b>起步价格</b><span>¥15/月</span></div>\n    <div class=\"panel-row\"><b>设备支持</b><span>3 至 20 台</span></div>\n    <div class=\"panel-row\"><b>流量额度</b><span>100GB 起</span></div>\n    <div class=\"panel-row\"><b>响应支持</b><span>工单 / 客户经理</span></div>\n    <div class=\"panel-note\">年付方案覆盖全部三档，无隐藏阶梯扣费，续费价格与首单一致。</div>\n    <a href=\"#plans\" class=\"panel-cta\">查看三档套餐</a>\n  </div>\n</section>\n\n<section class=\"section\" id=\"about\">\n  <div class=\"section-head\">\n    <h2>七八云在做什么？</h2>\n    <span class=\"tag\">关于我们</span>\n  </div>\n  <div class=\"intro\">\n    <div class=\"intro-q\">网络加速这件事，到底难在哪里？<br>为什么大多数人的体验是“时快时慢”？</div>\n    <div class=\"intro-a\">\n      <p>答案不在广告词里，而在三个被多数人忽略的地方：节点之间的负载是否均衡、跨网出口是否走了正确的对等线路、以及高峰时段的排队策略是否透明。七八云把这三件事拆开做，逐项优化。</p>\n      <p>我们的节点池按地区分层，普通线路用于日常浏览和下载，旗舰线路面向流媒体和低延迟游戏场景，团队线路则提供固定带宽与可定制路由。你选择的套餐决定你访问哪一层。</p>\n      <p>隐私方面，我们不记录访问目标域名和传输内容，仅保留连接时间与流量计费所需的聚合数据。工单和客户经理可以看到你的账户信息，但看不到你去了哪里。</p>\n    </div>\n  </div>\n</section>\n\n<section class=\"section\" id=\"plans\">\n  <div class=\"section-head\">\n    <h2>三档套餐，怎么选？</h2>\n    <span class=\"tag\">价格与权益</span>\n  </div>\n  <div class=\"plans\">\n\n    <article class=\"plan\">\n      <div class=\"plan-no\">01</div>\n      <div class=\"plan-head\">\n        <div class=\"plan-name\">基础版</div>\n        <div class=\"plan-price\">¥15/月<small>按年付仅需 ¥150/年</small></div>\n      </div>\n      <ul class=\"plan-feats\">\n        <li>每月 100GB 极速流量</li>\n        <li>支持 3 台设备同时在线</li>\n        <li>解锁基础流媒体</li>\n        <li>普通线路节点池</li>\n      </ul>\n      <a href=\"#\" class=\"plan-action\">选择基础版</a>\n    </article>\n\n    <article class=\"plan featured\">\n      <div class=\"plan-no\">02</div>\n      <div class=\"plan-head\">\n        <div class=\"plan-name\">旗舰版 <span class=\"plan-badge\">推荐</span></div>\n        <div class=\"plan-price\">¥35/月<small>按年付仅需 ¥350/年</small></div>\n      </div>\n      <ul class=\"plan-feats\">\n        <li>每月 300GB 极速流量</li>\n        <li>支持 5 台设备同时在线</li>\n        <li>全节点原生流媒体解锁</li>\n        <li>IPLC 专线游戏加速优化</li>\n        <li>7x24 优先工单支持</li>\n      </ul>\n      <a href=\"#\" class=\"plan-action\">选择旗舰版</a>\n    </article>\n\n    <article class=\"plan\">\n      <div class=\"plan-no\">03</div>\n      <div class=\"plan-head\">\n        <div class=\"plan-name\">团队版</div>\n        <div class=\"plan-price\">¥85/月<small>按年付仅需 ¥850/年</small></div>\n      </div>\n      <ul class=\"plan-feats\">\n        <li>每月 1000GB 极速流量</li>\n        <li>支持 20 台设备同时在线</li>\n        <li>VIP 专属高带宽节点</li>\n        <li>支持企业定制路由</li>\n        <li>专属客户经理服务</li>\n      </ul>\n      <a href=\"#\" class=\"plan-action\">选择团队版</a>\n    </article>\n\n  </div>\n</section>\n\n<section class=\"section\" id=\"guide\">\n  <div class=\"section-head\">\n    <h2>拿到套餐之后怎么用？</h2>\n    <span class=\"tag\">使用说明</span>\n  </div>\n  <div class=\"guide\">\n    <div class=\"step\">\n      <div class=\"step-no\">01</div>\n      <h3>领取接入参数</h3>\n      <p>完成订阅后，在你的账户页面会看到订阅链接和节点列表。复制订阅链接，准备粘贴到客户端。</p>\n    </div>\n    <div class=\"step\">\n      <div class=\"step-no\">02</div>\n      <h3>导入客户端</h3>\n      <p>打开对应平台的客户端，选择“从剪贴板导入”或“订阅管理”中粘贴链接，等待节点列表刷新完成。</p>\n    </div>\n    <div class=\"step\">\n      <div class=\"step-no\">03</div>\n      <h3>选择节点并连接</h3>\n      <p>根据用途选择节点：日常选普通线路，流媒体和游戏选旗舰线路，团队版用户可指定固定出口。</p>\n    </div>\n  </div>\n</section>\n\n<section class=\"clients\" id=\"clients\">\n  <div class=\"clients-inner\">\n    <h2>客户端与平台说明</h2>\n    <div class=\"client-grid\">\n      <div class=\"client-card\">\n        <h3>Windows / macOS 桌面端</h3>\n        <p>桌面端支持订阅自动更新、分流规则自定义和延迟测速。导入订阅链接后可按延迟排序选择节点。</p>\n        <div class=\"platform\">通用客户端适配 / 第三方开源工具</div>\n      </div>\n      <div class=\"client-card\">\n        <h3>iOS / Android 移动端</h3>\n        <p>移动端支持后台保持连接、按应用分流和流量统计。iOS 建议使用系统级 VPN 配置，Android 可使用开源客户端。</p>\n        <div class=\"platform\">通用客户端适配 / 第三方开源工具</div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"section\" id=\"faq\">\n  <div class=\"section-head\">\n    <h2>还有疑问？先看这里</h2>\n    <span class=\"tag\">常见问题</span>\n  </div>\n  <div class=\"faq-list\">\n\n    <details class=\"faq\">\n      <summary>流量用完了会怎样？还能继续上网吗？</summary>\n      <div class=\"faq-body\">当月流量用完后连接会被暂停，不会产生额外扣费。你可以选择等待次月自动恢复，或升级到更高档位的套餐补足流量。升级后差价按剩余天数折算。</div>\n    </details>\n\n    <details class=\"faq\">\n      <summary>旗舰版和基础版的节点池有什么实际区别？</summary>\n      <div class=\"faq-body\">基础版使用普通线路节点池，适合日常浏览和下载；旗舰版额外开放原生流媒体解锁节点和 IPLC 游戏加速线路，延迟更低、高峰时段排队优先级更高。团队版则提供固定带宽的 VIP 节点。</div>\n    </details>\n\n    <details class=\"faq\">\n      <summary>可以同时在不同设备上使用吗？上限是多少？</summary>\n      <div class=\"faq-body\">可以。基础版支持 3 台设备同时在线，旗舰版 5 台，团队版 20 台。超出限制后新设备无法连接，已连接的设备不受影响。你可以手动在账户页面踢出旧设备。</div>\n    </details>\n\n    <details class=\"faq\">\n      <summary>年付套餐中途可以退款吗？</summary>\n      <div class=\"faq-body\">购买后 7 天内且未使用超过 10GB 流量可全额退款。超过此范围后退款按未使用月份折算，已使用月份按月付价格扣减。具体流程请提交工单。</div>\n    </details>\n\n    <details class=\"faq\">\n      <summary>你们记录哪些用户数据？隐私边界在哪里？</summary>\n      <div class=\"faq-body\">我们保留账户注册信息、连接时间和聚合流量数据用于计费，不记录访问目标域名、传输内容和 DNS 查询。工单人员无法查看你的浏览记录，只能看到账户状态和流量统计。</div>\n    </details>\n\n    <details class=\"faq\">\n      <summary>团队版的企业定制路由是什么意思？</summary>\n      <div class=\"faq-body\">团队版支持指定固定出口 IP、按目标地址分流到不同节点、以及白名单访问控制。适合需要稳定出口用于办公系统接入或对外服务的团队。配置变更通过专属客户经理处理。</div>\n    </details>\n\n  </div>\n</section>\n\n</main>\n\n<footer>\n  <div class=\"foot-inner\">\n    <div><b>七八云</b> · 让每一比特都走对路</div>\n    <div>本页内容仅供参考，实际服务以订阅页面为准</div>\n  </div>\n</footer>",
